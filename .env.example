# Copy to .env. Keep comments on their own lines: compose reads an inline comment after an empty value as the value.

# latest: every model inside. slim: fetches the configured models at container start.
TINYASR_TAG=latest
# Model file: en-ru-uk, ar, en-es-it-pt, en-fa, en-km, fr-de, id-ms or uz. Change TINYASR_LANGS with it.
TINYASR_MODEL=/models/en-ru-uk.tzf
# Languages used when the UI sends no language_hint (the UI default). The server has no "all":
# list the model's languages. Each one adds a decode pass, so fewer is faster.
TINYASR_LANGS=en,ru,uk
# Set to /models/tinylid.bin to label each EndOfTurn with the language tinylid hears.
TINYASR_LID=
